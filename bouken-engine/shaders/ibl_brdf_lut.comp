#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rg16f) uniform writeonly image2D u_brdfLut;

layout(push_constant) uniform PushConstants {
    uint pc_resolution;
    uint pc_sampleCount;
} pc;

const float PI = 3.14159265359f;

// --- Hammersley low-discrepancy sequence ---
float radicalInverseVdC(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10f; // / 0x100000000
}

vec2 hammersley(uint i, uint n)
{
    return vec2(float(i) / float(n), radicalInverseVdC(i));
}

// --- GGX importance sampling ---
// Generates a half-vector H biased toward the specular lobe for a given roughness.
vec3 importanceSampleGGX(vec2 xi, float roughness)
{
    float a  = roughness * roughness;
    float a2 = a * a;

    // Spherical coordinates of the sampled half-vector
    float phi      = 2.0f * PI * xi.x;
    float cosTheta = sqrt((1.0f - xi.y) / (1.0f + (a2 - 1.0f) * xi.y));
    float sinTheta = sqrt(1.0f - cosTheta * cosTheta);

    // Tangent-space half-vector
    return vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
}

// --- Smith GGX geometry term (IBL form) ---
// Note: uses k = roughness^2/2 (IBL remapping), not the direct lighting remapping
float geometrySchlickGGX_IBL(float NdotV, float roughness)
{
    float a = roughness;
    float k = (a * a) / 2.0f;
    return NdotV / (NdotV * (1.0f - k) + k);
}

float geometrySmith_IBL(float NdotV, float NdotL, float roughness)
{
    return geometrySchlickGGX_IBL(NdotV, roughness)
         * geometrySchlickGGX_IBL(NdotL, roughness);
}

// --- Core integration ---
// Integrates the specular BRDF over the hemisphere for a given (NdotV, roughness),
// returning the F0 scale (R) and F0 bias (G) terms of the split-sum approximation.
vec2 integrateBRDF(float NdotV, float roughness)
{
    // Reconstruct view vector in tangent space from NdotV.
    // The actual azimuth doesn't matter due to isotropy - place V in the XZ plane.
    vec3 V = vec3(sqrt(1.0f - NdotV * NdotV), 0.0f, NdotV);

    float scale = 0.0f;
    float bias  = 0.0f;

    vec3 N = vec3(0.0f, 0.0f, 1.0f); // tangent-space normal = Z

    for (uint i = 0; i < pc.pc_sampleCount; ++i)
    {
        vec2 xi = hammersley(i, pc.pc_sampleCount);
        vec3 H  = importanceSampleGGX(xi, roughness);
        vec3 L  = normalize(2.0f * dot(V, H) * H - V);

        float NdotL = max(L.z, 0.0f);
        float NdotH = max(H.z, 0.0f);
        float VdotH = max(dot(V, H), 0.0f);

        if (NdotL > 0.0f)
        {
            float G    = geometrySmith_IBL(NdotV, NdotL, roughness);

            // Weight: G * VdotH / (NdotH * NdotV) — the standard importance-sampled
            // estimator for the BRDF denominator terms.
            float Gvis = (G * VdotH) / (NdotH * NdotV);

            // Schlick Fresnel factored out: F = F0*(1 - Fc) + Fc
            // where Fc = (1 - VdotH)^5
            float Fc = pow(1.0f - VdotH, 5.0f);

            scale += (1.0f - Fc) * Gvis; // F0 scale term
            bias  += Fc * Gvis;           // F0 bias term
        }
    }

    return vec2(scale, bias) / float(pc.pc_sampleCount);
}

void main()
{
    uvec2 texel = gl_GlobalInvocationID.xy;
    if (texel.x >= pc.pc_resolution || texel.y >= pc.pc_resolution)
        return;

    // Map texel to (NdotV, roughness) - clamp away from 0 to avoid singularities
    float NdotV     = max(float(texel.x) / float(pc.pc_resolution - 1), 0.001f);
    float roughness = max(float(texel.y) / float(pc.pc_resolution - 1), 0.001f);

    vec2 result = integrateBRDF(NdotV, roughness);
    imageStore(u_brdfLut, ivec2(texel), vec4(result, 0.0f, 1.0f));
}